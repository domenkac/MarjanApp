<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>si.marjanapp.local</string>
  <key>ProgramArguments</key><array>
    <string>/OPERATOR/FILL/APPROVED/VENV/bin/python</string>
    <string>-m</string><string>app.local_server</string>
    <string>--config</string><string>/OPERATOR/FILL/PRIVATE/server.json</string>
  </array>
  <key>WorkingDirectory</key><string>/OPERATOR/FILL/APPROVED/SOURCE</string>
  <key>EnvironmentVariables</key><dict>
    <key>DYLD_FALLBACK_LIBRARY_PATH</key><string>/OPERATOR/FILL/REVIEWED/HOMEBREW/lib</string>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>Umask</key><integer>63</integer>
  <key>ExitTimeOut</key><integer>0</integer>
</dict></plist>
